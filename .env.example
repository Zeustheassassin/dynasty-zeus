# ============================================================
# DynastyZeus — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is gitignored.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Found in your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
# Service-role key — server-only, bypasses RLS. Required for the
# cron routes (leaguemate-alerts, league-transactions) to read
# user_sleeper_links and write on behalf of any user. NEVER expose
# this client-side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Direct Postgres connection string (Supabase → Settings → Database).
# Optional — only used by scripts/backup-supabase.ps1 for local
# pg_dump backups; the app does not read it at runtime. Keep it out
# of CI / production environments.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Vercel Cron ──────────────────────────────────────────────
# Shared secret Vercel sends as `Authorization: Bearer ${CRON_SECRET}`
# when invoking scheduled jobs. Required by app/api/cron/* routes;
# without it the cron route returns 500 instead of running.
CRON_SECRET=generate-a-long-random-string

# ── Upstash Redis (distributed rate limiting) ────────────────
# Required for production on Vercel; without these the app falls
# back to a per-instance in-process rate limiter (fine for local
# dev, not effective across serverless cold-starts in prod).
# Create a Redis database at https://console.upstash.com and
# copy the REST URL + token from the database dashboard.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# ── Notes ─────────────────────────────────────────────────────
# All external data sources (Sleeper, FantasyCalc, FantasyPros,
# numberFire/FanDuel, ESPN, Google Sheets) are public APIs that
# require no keys. Only Supabase credentials are required for
# core functionality; all other vars are optional.
#
# After setting up, run the SQL migrations in supabase/migrations/
# against your Supabase project using the SQL editor or CLI.
