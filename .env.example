# ============================================================
# DynastyZeus — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is gitignored.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Found in your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
# Service-role key — server-only, bypasses RLS. Required for the
# cron routes (league-transactions, simulation-history,
# player-value-history) to read user_sleeper_links and write on
# behalf of any user, and for the shared cache writes in
# /api/fc-values and /api/stats/sleeper-weekly (those tables are
# SELECT-only for the anon key; without this key the routes still
# serve live data but skip the cache write). NEVER expose this
# client-side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Direct Postgres connection string (Supabase → Settings → Database).
# Optional — only used by scripts/backup-supabase.ps1 for local
# pg_dump backups; the app does not read it at runtime. Keep it out
# of CI / production environments.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Vercel Cron ──────────────────────────────────────────────
# Shared secret Vercel sends as `Authorization: Bearer ${CRON_SECRET}`
# when invoking scheduled jobs. Required by app/api/cron/* routes;
# without it the cron route returns 500 instead of running.
CRON_SECRET=generate-a-long-random-string

# ── Upstash Redis (distributed rate limiting) ────────────────
# Required for production on Vercel; without these the app falls
# back to a per-instance in-process rate limiter (fine for local
# dev, not effective across serverless cold-starts in prod).
# Create a Redis database at https://console.upstash.com and
# copy the REST URL + token from the database dashboard.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# ── CollegeFootballData (recruiting) ──────────────────────────
# Server-only key for the "Refresh from CFD" button in Scouting Hub
# → Recruits (app/api/recruiting/[year]/route.ts POST). Free tier,
# ~1000 calls/month — sign up at https://collegefootballdata.com/key.
# Without it, GET (reading cached recruits from Supabase) still works;
# only the CFD refresh fails. Must be set in Vercel's env vars too —
# it does NOT deploy automatically from .env.local.
CFD_API_KEY=your-cfd-api-key-here

# ── PFF Premium Stats (scouting) ──────────────────────────────
# Server-only key for the user's PFF Pro account (developer.pff.com), sent as
# `Authorization: Bearer` to https://api.pff.com by lib/pff/client.ts. Used by
# /api/pff/* (Scouting → PFF Links) to link prospects and charted games to
# PFF and to import PFF's stats for exactly those games (/api/pff/import).
# NEVER prefix it NEXT_PUBLIC_ — PFF says the key must never reach a
# browser. Reads are metered per account (~100/minute; the client paces
# itself). Without it the PFF routes answer 500 MISSING_PFF_KEY; nothing else
# changes. Must be set in Vercel's env vars too.
PFF_API_KEY=ak_your-pff-api-key-here

# ── Notes ─────────────────────────────────────────────────────
# All external data sources (Sleeper, FantasyCalc, FantasyPros,
# numberFire/FanDuel, ESPN, Google Sheets) are public APIs that
# require no keys. Only Supabase credentials are required for
# core functionality; CFD_API_KEY is required only for refreshing
# recruiting data, PFF_API_KEY only for the PFF links and stats; all other vars
# are optional.
#
# After setting up, run the SQL migrations in supabase/migrations/
# against your Supabase project using the SQL editor or CLI.
